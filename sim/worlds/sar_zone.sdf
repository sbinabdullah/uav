<?xml version="1.0" encoding="UTF-8"?>
<!-- sar_zone: simulated disaster zone for the SAR grid explorer.
     Based on PX4's default world. Drone spawns at world origin (ENU).
     AOI roughly x in [10, 60], y in [-20, 20]. Target ground truth is
     recorded in config/targets.yaml. -->
<sdf version="1.9">
  <world name="sar_zone">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction><ode/></friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1</iyy><iyz>0</iyz><izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <!-- ==================== ArUco targets (ids 0-3, 1.0 m panels) ============ -->
    <include>
      <uri>model://aruco_0</uri>
      <pose>15 -10 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://aruco_1</uri>
      <pose>30 5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://aruco_2</uri>
      <pose>45 -5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://aruco_3</uri>
      <pose>55 12 0 0 0 0</pose>
    </include>

    <!-- ==================== Color-anomaly targets ========================== -->
    <!-- victim: bright orange box -->
    <model name="victim_orange">
      <static>true</static>
      <pose>22 8 0.15 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.5 0.5 0.3</size></box></geometry>
          <material>
            <ambient>1.0 0.35 0.0 1</ambient>
            <diffuse>1.0 0.35 0.0 1</diffuse>
            <emissive>0.25 0.08 0.0 1</emissive>
          </material>
        </visual>
        <collision name="c">
          <geometry><box><size>0.5 0.5 0.3</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- hazard: red sphere -->
    <model name="hazard_red">
      <static>true</static>
      <pose>38 -14 0.3 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
          <material>
            <ambient>0.9 0.05 0.05 1</ambient>
            <diffuse>0.9 0.05 0.05 1</diffuse>
            <emissive>0.2 0.0 0.0 1</emissive>
          </material>
        </visual>
        <collision name="c">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
        </collision>
      </link>
    </model>

    <!-- barrel: yellow cylinder -->
    <model name="barrel_yellow">
      <static>true</static>
      <pose>50 2 0.3 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.85 0.05 1</ambient>
            <diffuse>0.95 0.85 0.05 1</diffuse>
            <emissive>0.2 0.18 0.0 1</emissive>
          </material>
        </visual>
        <collision name="c">
          <geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- ==================== Rubble props (non-targets) ===================== -->
    <model name="rubble_0">
      <static>true</static>
      <pose>20 -3 0.2 0 0 0.4</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>1.2 0.8 0.4</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>1.2 0.8 0.4</size></box></geometry></collision>
      </link>
    </model>
    <model name="rubble_1">
      <static>true</static>
      <pose>35 12 0.25 0 0 -0.3</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.9 1.4 0.5</size></box></geometry>
          <material><ambient>0.5 0.48 0.46 1</ambient><diffuse>0.5 0.48 0.46 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.9 1.4 0.5</size></box></geometry></collision>
      </link>
    </model>
    <model name="rubble_2">
      <static>true</static>
      <pose>48 -12 0.3 0 0 0.9</pose>
      <link name="link">
        <visual name="v">
          <geometry><cylinder><radius>0.5</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.42 0.42 0.44 1</ambient><diffuse>0.42 0.42 0.44 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><cylinder><radius>0.5</radius><length>0.6</length></cylinder></geometry></collision>
      </link>
    </model>
    <model name="rubble_3">
      <static>true</static>
      <pose>57 -2 0.2 0 0 0.2</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>1.5 0.6 0.4</size></box></geometry>
          <material><ambient>0.47 0.46 0.45 1</ambient><diffuse>0.47 0.46 0.45 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>1.5 0.6 0.4</size></box></geometry></collision>
      </link>
    </model>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
